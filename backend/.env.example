# Local HTTP development. Never commit backend/.env.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/task_management
MONGO_DB_NAME=task_management
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
CLIENT_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=taskflow_session
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
# Vercel backend: configure variables in the dashboard, not in a committed file.
# NODE_ENV=production
# MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/?retryWrites=true&w=majority
# MONGO_DB_NAME=taskflow (preview/integration: taskflow_test)
# CLIENT_ORIGIN=https://YOUR_FRONTEND_PROJECT.vercel.app
# SESSION_COOKIE_SAME_SITE=lax
# SESSION_COOKIE_SECURE=true
# ENABLE_EXPERIMENTAL_COREPACK=1
# Optional combined non-Vercel hosting only: SERVE_FRONTEND=true

# Backend-only email delivery. Configure a verified sender in Resend.
RESEND_API_KEY=replace_with_resend_sending_api_key
OTP_EMAIL_FROM=Taskflow <verify@your-verified-domain.example>
